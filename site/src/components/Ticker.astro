---
// Marquee strip under the nav. Two identical halves make the -50% translate loop
// seamless; 7 repeats put one half at ~5300px, past even 5K2K ultrawides.
const phrases = ['◀◀ REWYND', '60 SECONDS BACK', 'ONE KEY', 'CLEAN MP4', 'FREE & OPEN SOURCE'];
const repeats = Array.from({ length: 7 });
---
<div class="ticker" aria-hidden="true"><div class="in">
  {[0, 1].map(() => (
    <span class="half">{repeats.map(() => phrases.map((p) => <span>{p}</span>))}</span>
  ))}
</div></div>
