---
import { APPIMAGE_URL, WIN_SETUP_URL, OSX_SETUP_URL, INSTALL_CMD } from '../data/release';
---
<section class="dlband" id="download"><div class="in">
  <div class="eyebrow">Download</div>
  <h2>Get rewynd: free, about a minute to set up</h2>
  <div class="dl">
    <div class="plat">
      <div>
        <h3>Windows</h3>
        <p>Download the installer and run it. Per-user, no admin rights.</p>
      </div>
      <a class="btn acc" href={WIN_SETUP_URL}>Download installer</a>
    </div>
    <div class="plat">
      <div>
        <h3>Linux</h3>
        <p>One command installs the self-updating AppImage on any distro:</p>
      </div>
      <div class="cmd"><span class="cmdtext" id="installCmdLinux">{INSTALL_CMD}</span><button class="cp" data-copy="#installCmdLinux" aria-live="polite" aria-label="Copy install command">copy</button></div>
      <a class="btn ghost" href={APPIMAGE_URL}>Or grab the AppImage</a>
    </div>
    <div class="plat">
      <div>
        <h3>macOS</h3>
        <p>Apple Silicon, macOS 15+. The same one-liner installs rewynd.app:</p>
      </div>
      <div class="cmd"><span class="cmdtext" id="installCmdMac">{INSTALL_CMD}</span><button class="cp" data-copy="#installCmdMac" aria-live="polite" aria-label="Copy install command">copy</button></div>
      <a class="btn ghost" href={OSX_SETUP_URL}>Or download the .pkg</a>
    </div>
  </div>
  <div class="secnote">The app checks for updates on launch. One click updates everything in place.</div>
</div></section>
