---
import LogoMark from './LogoMark.astro';
import { INSTALL_CMD } from '../data/release';
---
<section class="band" id="opensource"><div class="wrap">
  <div class="os">
    <div>
      <div class="bandhead" style="margin-bottom:0"><span class="tag">Open source</span><h2 class="disp">Free, and actually yours</h2></div>
      <div class="oslist">
        <div class="osrow"><span class="t">✓</span><span><b>GPL-3.0.</b> Read it, build it, fork it. No telemetry, no account required to record.</span></div>
        <div class="osrow"><span class="t">✓</span><span><b>Local-first.</b> Clips live on your disk. Nothing uploads unless you press upload.</span></div>
        <div class="osrow"><span class="t">✓</span><span><b>Built in the open.</b> Issues and roadmap are public; self-updating, so fixes reach you quickly.</span></div>
        <div class="osrow"><span class="t">✓</span><span><b>Signed builds incoming</b> via the SignPath Foundation.</span></div>
      </div>
      <div class="osbtns"><a class="btn mint" href="https://github.com/gankedtv/rewynd">★ Star on GitHub</a><a class="btn" href="https://github.com/gankedtv/rewynd#readme">Read the docs</a></div>
    </div>
    <div class="repo">
      <div class="top"><LogoMark style="width:18px;height:18px" /><b>gankedtv / rewynd</b><span class="lic">GPL-3.0</span></div>
      <div class="body">
        <div class="ln"><span class="k">$</span> {INSTALL_CMD}</div>
        <div class="ln">↳ fetching latest AppImage…</div>
        <div class="ln"><span class="k">✓</span> rewynd installed · run <span class="w">rewynd</span> to start</div>
      </div>
    </div>
  </div>
</div></section>
